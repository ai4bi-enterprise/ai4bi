# ======================================================================
# AI4BI Chatbot - Community Edition
# Sao chép file này thành .env rồi chỉnh sửa. KHÔNG commit file .env.
# ======================================================================

# --- LLM Router MIỄN PHÍ (tùy chọn) -----------------------------------
# Thứ tự thử: provider đầu tiên lỗi / hết quota (429) -> provider kế tiếp -> Rule Router.
# Provider nào để trống API key sẽ tự bỏ qua. Để trống cả hai => chỉ dùng Rule Router.
LLM_PROVIDERS=gemini,groq

# Google Gemini – lấy key miễn phí tại https://aistudio.google.com (không cần thẻ)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Gemini 3.x không tắt được thinking; "low" là mức thấp nhất mọi dòng 3.x đều hỗ trợ
GEMINI_REASONING_EFFORT=low

# Groq – lấy key miễn phí tại https://console.groq.com (key dạng gsk_...)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# Thời gian chờ tối đa mỗi lần gọi LLM (giây)
LLM_TIMEOUT=15

# Sau khi điền key, BẮT BUỘC kiểm tra model ID + độ chính xác:
#   python tools/check_llm.py
# Lưu ý: free tier của Gemini có thể dùng nội dung gửi lên để cải thiện sản phẩm
# -> chỉ dùng với dữ liệu mẫu, KHÔNG gửi dữ liệu thật của doanh nghiệp.

# --- Phân tích tự động ------------------------------------------------
# Nhận xét · Đánh giá · Kết luận · Đề xuất · Gợi ý (theo quy tắc, không dùng LLM)
INSIGHTS_ENABLED=true

# --- Dữ liệu ----------------------------------------------------------
DATABASE_URL=sqlite:///./sample_data/enterprise_sample.db

# --- Web --------------------------------------------------------------
PORT=8000
# Giới hạn số câu hỏi/IP/ngày khi mở Live Demo công khai (0 = không giới hạn)
DEMO_RATE_LIMIT_PER_DAY=0
# Link nút "Liên hệ tích hợp" trên WebUI (Calendly / Google Form / Landing page)
CONTACT_URL=https://calendly.com/ai4bi-contact/demo
