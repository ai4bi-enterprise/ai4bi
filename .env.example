# ======================================================================
# AI4BI Lite – sao chép file này thành .env rồi chỉnh sửa. KHÔNG commit file .env.
# Không điền gì vẫn chạy: chatbot hiểu câu theo luật, mọi con số vẫn đúng như dashboard.
# ======================================================================

# --- LLM (tuỳ chọn) ---------------------------------------------------
# Thứ tự dự phòng cố định: Anthropic -> OpenAI -> Gemini. Hãng nào để trống thì bỏ qua.
# LLM chỉ đọc hiểu câu hỏi và viết lời nhận xét; SQL và con số do code tính từ lớp ngữ nghĩa.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # có gói miễn phí tại https://aistudio.google.com/apikey
LLM_ENABLED=auto         # auto | on | off
LLM_TIMEOUT=60

# --- Dữ liệu -----------------------------------------------------------
# Mặc định: data/aimoingay_demo.db (SQLite, dữ liệu mẫu đi kèm repo).
# DATABASE_URL=sqlite:///./data/aimoingay_demo.db
# COMPANY_NAME=Tên công ty của bạn

# --- Liên kết trên giao diện --------------------------------------------
# UPGRADE_URL=https://github.com/ai4bi-enterprise/ai4bi#-so-sánh-phiên-bản
# DEMO_URL=https://ai4bi.vercel.app/login
# CONTACT_PHONE=0938930369
# CONTACT_EMAIL=ai4bi.contact@gmail.com
